---
import PlannedWorkoutSummary from "@/components/workouts/PlannedWorkoutSummary.astro";
import AuthenticatedLayout from "@/layouts/AuthenticatedLayout.astro";
import { loadCurrentPlannedWorkout } from "@/lib/manual-workouts";

const { user, supabase } = Astro.locals;

if (!user || !supabase) {
  return Astro.redirect("/auth/signin");
}

const planResult = await loadCurrentPlannedWorkout(supabase, user.id);
const currentPlan = planResult.ok ? planResult.data : null;
const showSavedStatus = Astro.url.searchParams.get("status") === "workout-saved" && currentPlan !== null;
---

<AuthenticatedLayout title="Dashboard | Perfect Training Planner">
  <div class="mb-8">
    <p class="text-sm font-medium tracking-wide text-purple-300 uppercase">Private workspace</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Dashboard</h1>
    <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/65 sm:text-base">
      Welcome, <span class="font-semibold text-white">{user.email}</span>. Build and review your current planned
      workout.
    </p>
  </div>

  {
    showSavedStatus && (
      <p
        role="status"
        class="mb-5 rounded-xl border border-emerald-400/30 bg-emerald-500/10 px-4 py-3 text-sm text-emerald-100"
      >
        Your manual workout was saved successfully.
      </p>
    )
  }

  {
    !planResult.ok ? (
      <section class="rounded-2xl border border-red-400/30 bg-red-500/10 p-5 text-red-100 sm:p-7">
        <h2 class="text-lg font-semibold">Your planned workout could not be loaded</h2>
        <p class="mt-2 text-sm leading-6 text-red-100/80">
          Refresh the page to try again. No workout data was changed.
        </p>
      </section>
    ) : currentPlan ? (
      <PlannedWorkoutSummary plan={currentPlan} />
    ) : (
      <section class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-xl sm:p-8">
        <h2 class="text-2xl font-bold tracking-tight text-white">No planned workout yet</h2>
        <p class="mt-3 max-w-xl text-sm leading-6 text-blue-100/65 sm:text-base">
          Choose exercises from the catalogue and create an ordered sets-and-reps plan when you are ready.
        </p>
        <div class="mt-6">
          <a
            href="/workouts/new"
            class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-purple-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-purple-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-300 sm:w-auto"
          >
            Create manual workout
          </a>
        </div>
      </section>
    )
  }

  <section class="mt-6 rounded-2xl border border-white/10 bg-white/5 p-5 backdrop-blur-xl sm:p-6">
    <h2 class="text-sm font-semibold text-white">Account setup</h2>
    <p class="mt-1 text-sm text-blue-100/60">Manage the provider key reserved for future AI planning features.</p>
    <div class="mt-4">
      <a
        href="/account"
        class="inline-flex min-h-11 items-center justify-center rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold text-blue-50 transition-colors hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-300"
      >
        Configure AI key
      </a>
    </div>
  </section>
</AuthenticatedLayout>
