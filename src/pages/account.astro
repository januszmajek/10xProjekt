---
import AiKeyForm from "@/components/account/AiKeyForm";
import AuthenticatedLayout from "@/layouts/AuthenticatedLayout.astro";
import { getMaskedAiProviderKey, isAiProviderKeyEncryptionAvailable } from "@/lib/ai-provider-keys";

const { user, supabase } = Astro.locals;

if (!user || !supabase) {
  return Astro.redirect("/auth/signin");
}

const credentialResult = await getMaskedAiProviderKey(supabase, user.id);
const credential = credentialResult.ok ? credentialResult.data : null;
const encryptionAvailable = isAiProviderKeyEncryptionAvailable();

const statusMessages = {
  saved: { kind: "success", text: "Your OpenRouter key was saved." },
  removed: { kind: "success", text: "Your OpenRouter key was removed." },
  invalid: { kind: "error", text: "Enter a valid OpenRouter API key and try again." },
  unavailable: { kind: "error", text: "Key encryption is unavailable. Your existing key was not changed." },
  error: { kind: "error", text: "The account update could not be completed. Please try again." },
} as const;

const status = Astro.url.searchParams.get("status");
const statusMessage = status && status in statusMessages ? statusMessages[status as keyof typeof statusMessages] : null;
---

<AuthenticatedLayout title="Account | Perfect Training Planner">
  <div class="mx-auto max-w-2xl">
    <div class="mb-8">
      <p class="text-sm font-medium tracking-wide text-purple-300 uppercase">Account</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">AI provider key</h1>
      <p class="mt-3 max-w-xl text-sm leading-6 text-blue-100/65 sm:text-base">
        Add your own OpenRouter API key for future AI workout proposals. Your saved key is encrypted and can never be
        revealed from this page.
      </p>
    </div>

    {
      statusMessage && (
        <p
          role={statusMessage.kind === "error" ? "alert" : "status"}
          class:list={[
            "mb-4 rounded-xl border px-4 py-3 text-sm",
            statusMessage.kind === "success"
              ? "border-emerald-400/30 bg-emerald-500/10 text-emerald-100"
              : "border-red-400/30 bg-red-500/10 text-red-100",
          ]}
        >
          {statusMessage.text}
        </p>
      )
    }

    {
      !credentialResult.ok && (
        <p role="alert" class="mb-4 rounded-xl border border-red-400/30 bg-red-500/10 px-4 py-3 text-sm text-red-100">
          Credential settings could not be loaded. Please refresh and try again.
        </p>
      )
    }

    {
      !encryptionAvailable && (
        <p
          role="status"
          class="mb-4 rounded-xl border border-amber-300/30 bg-amber-400/10 px-4 py-3 text-sm text-amber-100"
        >
          Saving or replacing a key is temporarily unavailable because server-side encryption is not configured.
          Removing an existing key remains available.
        </p>
      )
    }

    <section
      class="rounded-2xl border border-white/10 bg-white/5 p-5 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-7"
    >
      <AiKeyForm
        configured={credential !== null}
        provider={credential?.provider ?? "openrouter"}
        keyHint={credential?.keyHint}
        updatedAt={credential?.updatedAt}
        encryptionAvailable={encryptionAvailable}
        client:load
      />
    </section>
  </div>
</AuthenticatedLayout>
