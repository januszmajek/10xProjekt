---
import type { CurrentPlannedWorkout } from "@/lib/planned-workouts";

interface Props {
  plan: CurrentPlannedWorkout;
}

const { plan } = Astro.props;

function formatCreatedAt(value: string): string {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "Creation time unavailable";
  }

  return new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "numeric",
    hour: "2-digit",
    minute: "2-digit",
    timeZoneName: "short",
  }).format(date);
}
---

<section class="rounded-2xl border border-white/10 bg-white/5 p-5 shadow-2xl shadow-black/10 backdrop-blur-xl sm:p-7">
  <div class="flex flex-col gap-4 border-b border-white/10 pb-5 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="text-sm font-medium tracking-wide text-purple-300 uppercase">Current planned workout</p>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-white">
        {plan.origin === "manual" ? "Manual plan" : "AI-generated plan"}
      </h2>
      <p class="mt-2 text-sm text-blue-100/60">
        Created <time datetime={plan.createdAt}>{formatCreatedAt(plan.createdAt)}</time>
      </p>
    </div>

    <a
      href="/workouts/new"
      class="inline-flex min-h-11 w-full items-center justify-center rounded-lg bg-purple-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-purple-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-300 sm:w-auto"
    >
      Build a replacement
    </a>
  </div>

  <ol class="mt-5 space-y-3" aria-label="Planned workout exercises">
    {
      plan.exercises.map((exercise, index) => (
        <li class="flex min-w-0 gap-3 rounded-xl border border-white/10 bg-black/15 p-4">
          <span
            class="flex size-8 shrink-0 items-center justify-center rounded-full bg-purple-500/15 text-sm font-semibold text-purple-100"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <div class="min-w-0">
            <p class="font-semibold break-words text-white">{exercise.name}</p>
            <p class="mt-1 text-sm text-blue-100/65">
              {exercise.sets} {exercise.sets === 1 ? "set" : "sets"} × {exercise.reps}{" "}
              {exercise.reps === 1 ? "rep" : "reps"}
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
